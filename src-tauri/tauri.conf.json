{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LVCE Tauri",
  "version": "0.1.0",
  "identifier": "io.github.lvce-editor.tauri",
  "build": {
    "frontendDist": "../.tmp/tsc/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LVCE Tauri",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
