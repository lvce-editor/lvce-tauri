{
  "name": "lvce-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "prepare:lvce": "npm run compile && node .tmp/tsc/scripts/prepare.js",
    "build:runtime": "npm run compile && node .tmp/tsc/scripts/build-runtime.js",
    "build": "tauri build",
    "test": "npm run compile && node --test .tmp/tsc/test/*.test.js",
    "test:e2e": "npm run compile && node .tmp/tsc/test/e2e.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "26.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "webdriverio": "10.2.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  }
}
