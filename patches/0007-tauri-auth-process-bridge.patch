+
+const nativeAuthTimers = new Map<string, ReturnType<typeof setTimeout>>()
+
+export const disposeOAuthServer = async (id: string): Promise<void> => {
+  clearTimeout(nativeAuthTimers.get(id))
+  nativeAuthTimers.delete(id)
+  const ipc = await AuthProcess.getOrCreate()
+  await JsonRpc.invoke(ipc, 'OAuthServer.dispose', id)
+}
+
+export const createOAuthServer = async (id: string, successHtml: string, errorHtml: string): Promise<number> => {
+  const ipc = await AuthProcess.getOrCreate()
+  const port = await JsonRpc.invoke(ipc, 'OAuthServer.create', id, successHtml, errorHtml)
+  clearTimeout(nativeAuthTimers.get(id))
+  // The worker disposes normally after its 30-second login wait. Bound ownership
+  // here too, in case its MessagePort disappears during reload or window close.
+  const timer = setTimeout(() => {
+    void disposeOAuthServer(id).catch(() => {})
+  }, 60_000)
+  timer.unref()
+  nativeAuthTimers.set(id, timer)
+  return port
+}
+
+export const getOAuthCode = async (id: string): Promise<string> => {
+  const ipc = await AuthProcess.getOrCreate()
+  return JsonRpc.invoke(ipc, 'OAuthServer.getCode', id)
+}
