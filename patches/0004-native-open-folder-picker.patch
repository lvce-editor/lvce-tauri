@@ -2,8 +2,37 @@ import * as Command from '../Command/Command.js'
 import * as PathToFileUri from '../PathToFileUri/PathToFileUri.js'
 import * as Prompt from '../Prompt/Prompt.js'
 
+const openNativeFolder = () =>
+  new Promise((resolve, reject) => {
+    const channel = new BroadcastChannel('lvce-tauri-folder-picker')
+    const id = crypto.randomUUID()
+    const timeout = setTimeout(() => {
+      channel.close()
+      resolve({ native: false })
+    }, 250)
+    channel.onmessage = ({ data }) => {
+      if (data?.id !== id) {
+        return
+      }
+      if (data.type === 'ready') {
+        clearTimeout(timeout)
+        return
+      }
+      if (data.type === 'result') {
+        channel.close()
+        if (data.error) {
+          reject(new Error(data.error))
+        } else {
+          resolve({ native: true, path: data.path })
+        }
+      }
+    }
+    channel.postMessage({ type: 'open-folder', id })
+  })
+
 export const openFolder = async () => {
-  const path = await Prompt.prompt('Choose Path:', '/home')
+  const result = typeof BroadcastChannel === 'function' ? await openNativeFolder() : { native: false }
+  const path = result.native ? result.path : await Prompt.prompt('Choose Path:', '/home')
   if (!path) {
     return
   }
